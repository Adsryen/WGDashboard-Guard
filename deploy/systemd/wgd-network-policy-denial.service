[Unit]
Description=WGDashboard Network Policy Denial Responder
Documentation=https://github.com/WGDashboard/WGDashboard
After=network-online.target wgd-network-policy-agent.service
Wants=network-online.target
# 2026-09-23: Wants, not Requires. The collector was killed off at boot by Requires=agent
# on 2026-09-22 and stayed down for 21h30m; this responder only needs a TCP listener and
# has no hard dependency on the Agent's socket.
Wants=wgd-network-policy-agent.service
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/WGDashboard/src
Environment=PYTHONPATH=/opt/WGDashboard/src
ExecStart=/usr/bin/python3 -m network_policy.denial_responder --host 0.0.0.0 --port 61573
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
